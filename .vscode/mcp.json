{
  "servers": {
    "FabricIQ": {
      "type": "http",
      "url": "https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq",
      "headers": {
        "X-VARIANTS": "Fabric.Routing.FabricIQ.V1",
        "Authorization": "Bearer ${input:fabric-token}"
      }
    }
  },
  "inputs": [
    {
      "id": "fabric-token",
      "type": "promptString",
      "description": "Fabric access token",
      "password": true
    }
  ]
}
